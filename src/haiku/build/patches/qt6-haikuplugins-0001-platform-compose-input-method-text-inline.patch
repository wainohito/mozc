+#ifndef QHAIKUINPUTCONTEXT_H
+#define QHAIKUINPUTCONTEXT_H
+
+#include <qpa/qplatforminputcontext.h>
+
+#include <QtCore/QPointer>
+#include <QtCore/QString>
+
+#include <Messenger.h>
+
+class BMessage;
+
+QT_BEGIN_NAMESPACE
+
+class QHaikuWindow;
+
+// Bridges the input methods of the input_server (B_INPUT_METHOD_EVENT) to
+// Qt, so that Japanese, Chinese and Korean text can be composed inline in
+// Qt widgets.
+//
+// Views of Qt windows are only marked B_INPUT_METHOD_AWARE while the focused
+// object accepts input method events; for anything else the input_server
+// keeps using its bottom-line window, which sends the result as key presses.
+class QHaikuInputContext : public QPlatformInputContext
+{
+	Q_OBJECT
+public:
+	QHaikuInputContext();
+	~QHaikuInputContext() override;
+
+	bool isValid() const override { return true; }
+
+	void reset() override;
+	void commit() override;
+	void update(Qt::InputMethodQueries queries) override;
+	void setFocusObject(QObject *object) override;
+
+	// Called in the GUI thread for every B_INPUT_METHOD_EVENT that reached
+	// a Qt window.
+	void handleInputMethodMessage(QHaikuWindow *window, const BMessage *message);
+
+private:
+	void handleChanged(const BMessage *message);
+	void handleStopped();
+	void handleLocationRequest(QHaikuWindow *window);
+	void commitPreedit(QObject *target);
+	void stopInputMethod();
+	void updateInputMethodAwareness();
+
+	QPointer<QObject> m_focusObject;
+	BMessenger m_method;
+	QString m_preedit;
+	bool m_active;
+};
+
+QT_END_NAMESPACE
+
+#endif
