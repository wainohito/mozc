+
+#include "qhaikuinputcontext.h"
+#include "qhaikuview.h"
+#include "qhaikuwindow.h"
+
+#include <QtCore/QCoreApplication>
+#include <QtCore/QList>
+#include <QtGui/QGuiApplication>
+#include <QtGui/QInputMethod>
+#include <QtGui/QInputMethodEvent>
+#include <QtGui/QPalette>
+#include <QtGui/QTextCharFormat>
+#include <QtGui/QWindow>
+
+#include <Input.h>
+#include <Message.h>
+#include <View.h>
+#include <Window.h>
+
+QT_BEGIN_NAMESPACE
+
+namespace {
+
+// The offsets of B_INPUT_METHOD_EVENT are byte offsets into UTF-8.
+int utf16Offset(const QByteArray &utf8, int32 byteOffset)
+{
+	if (byteOffset <= 0)
+		return 0;
+	if (byteOffset >= utf8.size())
+		return QString::fromUtf8(utf8).size();
+	return QString::fromUtf8(utf8.constData(), byteOffset).size();
+}
+
+int utf8CharCount(const QString &text)
+{
+	int count = 0;
+	for (const QChar c : text) {
+		if (!c.isLowSurrogate())
+			count++;
+	}
+	return count;
+}
+
+} // namespace
+
+
+QHaikuInputContext::QHaikuInputContext()
+	: m_active(false)
+{
+}
+
+
+QHaikuInputContext::~QHaikuInputContext()
+{
+}
+
+
+void QHaikuInputContext::reset()
+{
+	// Qt asks to drop the composition (a click into the text, for example).
+	// Keep what the user sees, the same as BTextView does, and tell the input
+	// method that the composition is over. Without a preedit there is nothing
+	// to end, and a stop could cross a composition the method just started.
+	if (m_preedit.isEmpty())
+		return;
+	commitPreedit(m_focusObject);
+	stopInputMethod();
+}
+
+
+void QHaikuInputContext::commit()
+{
+	reset();
+}
+
+
+void QHaikuInputContext::update(Qt::InputMethodQueries queries)
+{
+	if (queries & Qt::ImEnabled)
+		updateInputMethodAwareness();
+}
+
+
+void QHaikuInputContext::setFocusObject(QObject *object)
+{
+	if (object != m_focusObject && !m_preedit.isEmpty()) {
+		commitPreedit(m_focusObject);
+		stopInputMethod();
+	}
+	m_focusObject = object;
+	updateInputMethodAwareness();
+}
+
+
+void QHaikuInputContext::handleInputMethodMessage(QHaikuWindow *window,
+	const BMessage *message)
+{
+	int32 opcode;
+	if (message->FindInt32("be:opcode", &opcode) != B_OK)
+		return;
+
+	switch (opcode) {
+		case B_INPUT_METHOD_STARTED:
+			if (message->FindMessenger("be:reply_to", &m_method) == B_OK)
+				m_active = true;
+			m_preedit.clear();
+			break;
+		case B_INPUT_METHOD_CHANGED:
+			handleChanged(message);
+			break;
+		case B_INPUT_METHOD_STOPPED:
+			handleStopped();
+			break;
+		case B_INPUT_METHOD_LOCATION_REQUEST:
+			handleLocationRequest(window);
+			break;
+	}
+}
+
+
+void QHaikuInputContext::handleChanged(const BMessage *message)
+{
+	QObject *target = QGuiApplication::focusObject();
+	if (target == nullptr)
+		return;
+
+	const char *string = nullptr;
+	if (message->FindString("be:string", &string) != B_OK || string == nullptr)
+		string = "";
+	const QByteArray utf8(string);
+	const QString text = QString::fromUtf8(utf8);
+
+	bool confirmed;
+	if (message->FindBool("be:confirmed", &confirmed) != B_OK)
+		confirmed = false;
+
+	if (confirmed) {
+		QInputMethodEvent event;
+		event.setCommitString(text);
+		QCoreApplication::sendEvent(target, &event);
+		m_preedit.clear();
+		return;
+	}
+
+	QList<QInputMethodEvent::Attribute> attributes;
+
+	// Clauses are underlined, the clause being converted is highlighted.
+	QTextCharFormat clauseFormat;
+	clauseFormat.setUnderlineStyle(QTextCharFormat::SingleUnderline);
+	int32 clauseStart;
+	int32 clauseEnd;
+	for (int32 i = 0;
+		message->FindInt32("be:clause_start", i, &clauseStart) == B_OK
+			&& message->FindInt32("be:clause_end", i, &clauseEnd) == B_OK;
+		i++) {
+		const int start = utf16Offset(utf8, clauseStart);
+		const int end = utf16Offset(utf8, clauseEnd);
+		if (end > start) {
+			attributes << QInputMethodEvent::Attribute(
+				QInputMethodEvent::TextFormat, start, end - start, clauseFormat);
+		}
+	}
+	if (attributes.isEmpty() && !text.isEmpty()) {
+		attributes << QInputMethodEvent::Attribute(
+			QInputMethodEvent::TextFormat, 0, text.size(), clauseFormat);
+	}
+
+	int cursor = text.size();
+	bool cursorVisible = true;
+	int32 selectionStart;
+	int32 selectionEnd;
+	if (message->FindInt32("be:selection", 0, &selectionStart) == B_OK
+		&& message->FindInt32("be:selection", 1, &selectionEnd) == B_OK) {
+		const int start = utf16Offset(utf8, selectionStart);
+		const int end = utf16Offset(utf8, selectionEnd);
+		cursor = start;
+		if (end > start) {
+			const QPalette palette = QGuiApplication::palette();
+			QTextCharFormat selectionFormat;
+			selectionFormat.setBackground(palette.highlight());
+			selectionFormat.setForeground(palette.highlightedText());
+			attributes << QInputMethodEvent::Attribute(
+				QInputMethodEvent::TextFormat, start, end - start,
+				selectionFormat);
+			// The highlight shows where the user is; a caret would only
+			// distract while a clause is being converted.
+			cursorVisible = false;
+		}
+	}
+	attributes << QInputMethodEvent::Attribute(QInputMethodEvent::Cursor,
+		cursor, cursorVisible ? 1 : 0, QVariant());
+
+	QInputMethodEvent event(text, attributes);
+	QCoreApplication::sendEvent(target, &event);
+	m_preedit = text;
+}
+
+
+void QHaikuInputContext::handleStopped()
+{
+	// An input method that stops without confirming leaves its text in place,
+	// as BTextView does.
+	commitPreedit(QGuiApplication::focusObject());
+	m_method = BMessenger();
+	m_active = false;
+}
+
+
+void QHaikuInputContext::handleLocationRequest(QHaikuWindow *window)
+{
+	if (!m_active || !m_method.IsValid())
+		return;
+
+	QWindow *qwindow = window != nullptr ? window->window() : nullptr;
+	if (qwindow == nullptr)
+		qwindow = QGuiApplication::focusWindow();
+	if (qwindow == nullptr)
+		return;
+
+	// The cursor attribute of the preedit is put at the clause being
+	// converted, so the cursor rectangle is where the candidates belong.
+	const QRectF rect = QGuiApplication::inputMethod()->cursorRectangle();
+	const qreal ratio = qwindow->devicePixelRatio();
+	const QPoint topLeft = qwindow->mapToGlobal(rect.topLeft().toPoint());
+
+	BMessage reply(B_INPUT_METHOD_EVENT);
+	reply.AddInt32("be:opcode", B_INPUT_METHOD_LOCATION_REQUEST);
+	// One location per character is expected; Qt only knows the cursor.
+	const int count = qMax(1, utf8CharCount(m_preedit));
+	for (int i = 0; i < count; i++) {
+		reply.AddPoint("be:location_reply",
+			BPoint(topLeft.x() * ratio, topLeft.y() * ratio));
+		reply.AddFloat("be:height_reply", rect.height() * ratio);
+	}
+	m_method.SendMessage(&reply);
+}
+
+
+void QHaikuInputContext::commitPreedit(QObject *target)
+{
+	if (m_preedit.isEmpty())
+		return;
+	if (target != nullptr) {
+		QInputMethodEvent event;
+		event.setCommitString(m_preedit);
+		QCoreApplication::sendEvent(target, &event);
+	}
+	m_preedit.clear();
+}
+
+
+void QHaikuInputContext::stopInputMethod()
+{
+	if (m_active && m_method.IsValid()) {
+		BMessage message(B_INPUT_METHOD_EVENT);
+		message.AddInt32("be:opcode", B_INPUT_METHOD_STOPPED);
+		m_method.SendMessage(&message);
+	}
+	m_method = BMessenger();
+	m_active = false;
+}
+
+
+void QHaikuInputContext::updateInputMethodAwareness()
+{
+	QWindow *qwindow = QGuiApplication::focusWindow();
+	if (qwindow == nullptr || qwindow->handle() == nullptr)
+		return;
+
+	QHaikuSurfaceView *view = QHaikuWindow::viewForWinId(qwindow->winId());
+	if (view == nullptr || !view->LockLooper())
+		return;
+
+	const bool aware = inputMethodAccepted();
+	const uint32 flags = view->Flags();
+	const bool changed = ((flags & B_INPUT_METHOD_AWARE) != 0) != aware;
+	if (changed) {
+		view->SetFlags(aware ? flags | B_INPUT_METHOD_AWARE
+			: flags & ~B_INPUT_METHOD_AWARE);
+	}
+	// The input_server learns about the flag when the focus view of the
+	// window changes. Qt does not otherwise give the view the focus: keys
+	// reach the window either way.
+	if (!view->IsFocus()) {
+		if (aware)
+			view->MakeFocus(true);
+	} else if (changed) {
+		view->MakeFocus(false);
+		view->MakeFocus(true);
+	}
+	view->UnlockLooper();
+}
+
+QT_END_NAMESPACE
