diff --git a/platforms/qhaikuplatform/haiku/qhaikuwindow.cpp b/platforms/qhaikuplatform/haiku/qhaikuwindow.cpp
index 928b9b9..168d940 100644
--- a/platforms/qhaikuplatform/haiku/qhaikuwindow.cpp
+++ b/platforms/qhaikuplatform/haiku/qhaikuwindow.cpp
@@ -39,6 +39,7 @@
 ****************************************************************************/
 
 #include "qhaikuwindow.h"
+#include "qhaikuinputcontext.h"
 #include "qhaikukeymap.h"
 #include "qhaikusettings.h"
 
@@ -183,6 +184,10 @@ void QtHaikuWindow::DispatchMessage(BMessage *msg, BHandler *handler)
 				Q_EMIT keyEvent(press ? QEvent::KeyPress : QEvent::KeyRelease, qt_keycode, fView->hostToQtModifiers(modifiers), text);
 				break;
 			}
+		case B_INPUT_METHOD_EVENT:
+			// Handled in the GUI thread, in order with the key events.
+			Q_EMIT inputMethodEvent(new BMessage(*msg));
+			return;
 		default:
 			break;
 	}
@@ -328,6 +333,9 @@ QHaikuWindow::QHaikuWindow(QWindow *wnd)
 		this, SLOT(platformWheelEvent(QPoint, QPoint, int, Qt::Orientation, Qt::KeyboardModifiers)));
 	connect(m_window, SIGNAL(keyEvent(QEvent::Type, int, Qt::KeyboardModifiers, QString)),
 		this, SLOT(platformKeyEvent(QEvent::Type, int, Qt::KeyboardModifiers, QString)));
+	qRegisterMetaType<BMessage*>("BMessage*");
+	connect(m_window, SIGNAL(inputMethodEvent(BMessage*)),
+		this, SLOT(platformInputMethodEvent(BMessage*)));
 
 	connect(m_window->View(), SIGNAL(enteredView()), this, SLOT(platformEnteredView()));
 	connect(m_window->View(), SIGNAL(exitedView()), this, SLOT(platformExitedView()));
@@ -936,6 +944,16 @@ BRegion QHaikuWindow::getClippingRegion()
 }
 
 
+void QHaikuWindow::platformInputMethodEvent(BMessage *message)
+{
+	QHaikuInputContext *context = qobject_cast<QHaikuInputContext*>(
+		QGuiApplicationPrivate::platformIntegration()->inputContext());
+	if (context != nullptr)
+		context->handleInputMethodMessage(this, message);
+	delete message;
+}
+
+
 void QHaikuWindow::platformWindowQuitRequested()
 {
     QWindowSystemInterface::handleCloseEvent(window());
