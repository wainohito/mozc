+// A trace of the input method events, for finding out what goes wrong in a
+// given application. On only while ~/config/settings/qhaiku-im-debug exists
+// (checked once, at start); written to /tmp/qhaiku-im.log.
+bool traceEnabled()
+{
+	static int enabled = -1;
+	if (enabled < 0) {
+		char path[B_PATH_NAME_LENGTH];
+		enabled = find_directory(B_USER_SETTINGS_DIRECTORY, -1, false, path,
+				sizeof(path)) == B_OK
+			&& QFile::exists(QString::fromUtf8(path)
+				+ QStringLiteral("/qhaiku-im-debug")) ? 1 : 0;
+	}
+	return enabled == 1;
+}
+
+QString describe(QObject *object)
+{
+	if (object == nullptr)
+		return QStringLiteral("null");
+	return QString::fromLatin1(object->metaObject()->className())
+		+ QStringLiteral("(") + object->objectName() + QStringLiteral(")");
+}
+
+void trace(const QString &text)
+{
+	if (!traceEnabled())
+		return;
+	QFile file(QStringLiteral("/tmp/qhaiku-im.log"));
+	if (!file.open(QIODevice::Append | QIODevice::Text))
+		return;
+	file.write(QDateTime::currentDateTime().toString(
+		QStringLiteral("hh:mm:ss.zzz ")).toUtf8());
+	file.write(text.toUtf8());
+	file.write("\n");
+}
+
+// Windows that take Qt's focus but not the keyboard's: popups, such as the
+// completer lists of address and search fields, and the window showing what
+// is being dragged. Haiku keeps the keyboard focus, and with it the input
+// method, on the window below.
+bool isTransientFocusWindow(QWindow *window)
+{
+	if (window == nullptr)
+		return false;
+	const Qt::WindowType type = window->type();
+	return type == Qt::Popup || type == Qt::ToolTip
+		|| window->inherits("QShapedPixmapWindow");
+}
+
+// Asks an object whether it takes input method events.
+bool acceptsInputMethod(QObject *object)
+{
+	if (object == nullptr)
+		return false;
+	QInputMethodQueryEvent query(Qt::ImEnabled);
+	QCoreApplication::sendEvent(object, &query);
+	return query.value(Qt::ImEnabled).toBool();
+}
+
 } // namespace
 
 
