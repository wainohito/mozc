-void QHaikuInputContext::handleChanged(const BMessage *message)
+QObject *QHaikuInputContext::inputTarget(QHaikuWindow *window) const
 {
-	QObject *target = QGuiApplication::focusObject();
-	if (target == nullptr)
+	// The input method talks to the window with the keyboard focus, which
+	// is the one the event arrived in. Qt may have put its own focus in a
+	// popup or a drag window of the application meanwhile; the text is still
+	// for the field of the window below, and sent to the popup it was lost.
+	QWindow *eventWindow = window != nullptr ? window->window() : nullptr;
+	QWindow *focusWindow = QGuiApplication::focusWindow();
+	if (eventWindow != nullptr && focusWindow != eventWindow
+		&& eventWindow->focusObject() != nullptr) {
+		return eventWindow->focusObject();
+	}
+	return QGuiApplication::focusObject();
+}
